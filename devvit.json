{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ghost-rally",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Ghost Rally hub post",
        "description": "Creates (or finds) the pinned Ghost Rally home post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-hub"
      },
      {
        "label": "Ghost Rally: reset all times",
        "description": "Wipes every record, ghost and leaderboard (tracks survive). Use after physics changes.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-all"
      },
      {
        "label": "Ghost Rally: post yesterday's recap",
        "description": "Posts the Daily Rally podium recap without waiting for the scheduler",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/recap-now"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-recap": {
        "endpoint": "/internal/scheduler/daily-recap",
        "cron": "5 0 * * *"
      }
    }
  },
  "permissions": {
    "journeys": true,
    "reddit": {
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "ghost_rally_dev"
  }
}